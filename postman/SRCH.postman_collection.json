  "item": [
    {
      "name": "SRCH_API_01 - search \"Samsung\"",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5001/searchProduct/Samsung",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "searchProduct",
            "Samsung"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
