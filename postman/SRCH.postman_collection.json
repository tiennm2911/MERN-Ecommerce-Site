    },
    {
      "name": "SRCH_API_04 - Regex injection .* (BUG)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5001/searchProduct/.*",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "searchProduct",
            ".*"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"BUG: regex injection returns all products\", () => { const arr = pm.response.json(); pm.expect(Array.isArray(arr) && arr.length > 5).to.be.true; });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
