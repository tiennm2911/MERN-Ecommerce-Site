          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"BUG: special regex chars not escaped\", () => { pm.expect(pm.response.code).to.be.oneOf([200, 500]); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
