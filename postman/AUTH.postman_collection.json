{
  "info": {
    "name": "SHOPCART - AUTH API Tests (Nguyễn Minh Tiến)",
    "description": "AUTH module automation tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "00000000-6j7nh4tv-0000-0000-000000000000"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001"
    }
  ],
  "item": [
    {
      "name": "AUTH_API_01 - Đăng ký Customer hợp lệ",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "http://localhost:5001/CustomerRegister",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "CustomerRegister"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"AUTH_01 User\",\n  \"email\": \"auth01_{{$timestamp}}@gmail.com\",\n  \"password\": \"Test@1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Has _id field\", () => pm.expect(pm.response.json()).to.have.property(\"_id\"));",
              "pm.collectionVariables.set(\"customerEmail\", \"auth01_\" + Date.now() + \"@gmail.com\");"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
